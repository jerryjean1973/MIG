# Blank values are intentional. Supply private values through your secret manager.
NODE_ENV=production
PORT=5000
MIG_DATABASE_URL=
MIG_TENANT_ID=
MIG_PUBLIC_ORIGIN=
MIG_OIDC_ISSUER=
MIG_OIDC_CLIENT_ID=
MIG_OIDC_CLIENT_SECRET=
MIG_OIDC_TENANT_CLAIM=tenant_id
MIG_OIDC_TENANT_REF=
MIG_OIDC_ROLE_CLAIM=roles
MIG_OIDC_ADMIN_ROLE=MIG.Admin
MIG_OWNER_BRIDGE_URL=
