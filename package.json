{
  "name": "@mig/standalone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.3",
    "@radix-ui/react-select": "2.1.7",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.1.4",
    "@radix-ui/react-tabs": "1.1.4",
    "@radix-ui/react-toast": "1.2.7",
    "@tanstack/react-query": "5.60.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.39.3",
    "drizzle-zod": "0.7.1",
    "express": "5.2.1",
    "jose": "6.2.11",
    "lucide-react": "0.453.0",
    "openid-client": "6.8.7",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "saxes": "6.0.0",
    "tailwind-merge": "2.6.0",
    "undici": "7.16.0",
    "wouter": "3.3.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.7",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.28.2",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.6.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
